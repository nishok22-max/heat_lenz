# Copy to backend/.env (gitignored) and fill in. Never commit the real file.

# Groq free API key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional last-resort fallback provider (Google AI Studio key). Leave empty to use Groq only.
GEMINI_API_KEY=

# Optional overrides (defaults in backend/app/chat/settings.py)
# CHAT_PRIMARY_MODEL=openai/gpt-oss-120b
# CHAT_BACKUP_MODEL=openai/gpt-oss-20b
# CHAT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

# Shared memory/rate limits for more than one API replica (docker-compose sets this).
# CHAT_REDIS_URL=redis://localhost:6379/0
